# Postgres (Neon/Vercel Postgres) — хранит меню и заказы
DATABASE_URL=

# ЮKassa (подключим на этапе оформления заказа)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Telegram-бот для уведомлений о заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публичный URL сайта (для вебхуков и редиректов после оплаты)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Пароль для входа в админку (/admin)
ADMIN_PASSWORD=

# Cloudinary — хранение загруженных фото (блюда, hero, галерея)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
